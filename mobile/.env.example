# ─────────────────────────────────────────────────────────────────────────────
# MindOS Mobile App — Environment Variable Reference
# Used via react-native-config or a similar ENV bridge.
# Copy to .env and fill in for each environment.
# ─────────────────────────────────────────────────────────────────────────────

# ── API Configuration ─────────────────────────────────────────────────────────
# Local development (iOS Simulator)
API_BASE_URL=http://localhost:5001/api

# Android Emulator (connects to host machine)
# API_BASE_URL=http://10.0.2.2:5001/api

# Staging
# API_BASE_URL=https://api-staging.mindos.app/api

# Production
# API_BASE_URL=https://api.mindos.app/api
